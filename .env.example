# ─── Runtime environment ───────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=DEBUG
APP_VERSION=0.1.0

# ─── Database ──────────────────────────────────────────────────────────────────
# Postgres used for local dev via `docker compose up -d db`.
DATABASE_URL=postgresql+psycopg://neet:neet_dev_password@localhost:5432/neet_compass
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ─── Security ──────────────────────────────────────────────────────────────────
# Used to sign future API tokens. 32+ random bytes: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# ─── ETL ───────────────────────────────────────────────────────────────────────
ETL_RAW_ROOT=./data/raw
ETL_PROCESSED_ROOT=./data/processed
ETL_EXPORT_ROOT=./data/exports
ETL_BATCH_SIZE=1000

# ─── ML ────────────────────────────────────────────────────────────────────────
# Recommendation engine backend. `unavailable` is the safe default: the system
# refuses to fabricate predictions until a real engine is registered.
ML_RECOMMENDATION_ENGINE=unavailable
ML_MODEL_REGISTRY_PATH=./data/cache/models

# ─── CORS (browser clients; empty in production) ───────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
